{
  "name": "ytmusic-counter",
  "version": "1.1.0",
  "description": "Tracks and counts your played tracks, albums, and listening duration on YouTube Music.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"background/**\" --test-coverage-include=\"shared/**\" --test-coverage-include=\"content/**\" --test-coverage-exclude=\"tests/**\" tests/*.test.js",
    "test:gate": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=\"background/**\" --test-coverage-include=\"shared/**\" --test-coverage-include=\"content/**\" --test-coverage-exclude=\"tests/**\" tests/*.test.js",
    "prepare": "git config core.hooksPath .githooks",
    "lint:firefox": "npx --yes web-ext@10.7.0 lint --source-dir dist/firefox",
    "build": "node tools/build.mjs && npm run lint:firefox",
    "build:chrome": "node tools/build.mjs chrome",
    "build:firefox": "node tools/build.mjs firefox && npm run lint:firefox"
  },
  "keywords": [
    "youtube-music",
    "counter",
    "extension",
    "play-counts",
    "duration"
  ],
  "author": "r4pture-maik",
  "license": "MIT"
}
